default_platform(:ios)

# Load App Store Connect API key from env vars if present
def asc_api_key
  key_id    = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_path  = ENV["APP_STORE_CONNECT_KEY_PATH"]
  return nil unless key_id && issuer_id && key_path
  app_store_connect_api_key(
    key_id:        key_id,
    issuer_id:     issuer_id,
    key_filepath:  key_path,
    in_house:      false
  )
end

platform :ios do

  # ── beta ─────────────────────────────────────────────────────────────────
  # Usage: bundle exec fastlane beta
  # Builds and uploads a new TestFlight build.
  desc "Build and upload to TestFlight"
  lane :beta do
    # Ensure UTF-8 locale so fastlane can parse Xcode logs
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"

    # 1. Make sure Flutter dependencies are up to date
    sh("flutter pub get", chdir: "..")

    # 2. Bump build number (uses timestamp — always unique, no conflicts)
    build_number = Time.now.strftime("%Y%m%d%H%M").to_i
    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/Runner.xcodeproj"
    )
    UI.message "Build number → #{build_number}"

    # 3. Build IPA
    build_app

    # 4. Upload to TestFlight
    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success "TestFlight build #{build_number} uploaded ✓"
  end

  # ── screenshots ──────────────────────────────────────────────────────────
  # Usage: bundle exec fastlane screenshots
  # Runs UITests to capture screenshots, then frames them.
  # Requires RunnerUITests target in Xcode (see ios/RunnerUITests/).
  desc "Capture and frame App Store screenshots"
  lane :screenshots do
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"
    # Pre-build for simulator so Flutter SPM packages are resolved
    sh("flutter build ios --simulator --no-codesign", chdir: "..")
    capture_ios_screenshots
    frame_screenshots(white: true)
  end

  # ── release ──────────────────────────────────────────────────────────────
  # Usage: bundle exec fastlane release
  # Uploads metadata + screenshots to App Store (does NOT submit for review).
  desc "Upload metadata and screenshots to App Store"
  lane :release do
    deliver(
      api_key: asc_api_key,
      submit_for_review:  false,
      automatic_release:  false,
      force:              true,  # skip HTML preview
      precheck_include_in_app_purchases: false
    )
  end

  # ── metadata_only ────────────────────────────────────────────────────────
  desc "Push only metadata (no binary, no screenshots)"
  lane :metadata_only do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots:   true,
      force:              true
    )
  end

end
